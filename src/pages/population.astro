---
import "leaflet/dist/leaflet.css";
import Layout from "../layouts/Layout.astro";
import population from "../assets/populationMain.json";

const periods = [...new Set(population.map((row) => row["Période"]))].sort(
    (first, second) => second - first,
);
const sexes = [...new Set(population.map((row) => row["Sexe"]))];
const ages = [...new Set(population.map((row) => row["Âge"]))];
---

<Layout
    title="Population des départements — Carte"
    description="Carte interactive de la population des départements français."
>
    <main class="ml-40 mt-10 max-w-5xl pr-8 pb-16">
        <h1>Population des départements</h1>
        <p>
            Choisissez une période, un sexe et une tranche d'âge pour mettre à
            jour la carte.
        </p>
        <div class="map-filters">
            <label for="periode">
                Période
                <select id="periode">
                    {periods.map((period, index) => (
                        <option value={period} selected={index === 0}>{period}</option>
                    ))}
                </select>
            </label>
            <label for="sexe">
                Sexe
                <select id="sexe">
                    {sexes.map((sex, index) => (
                        <option value={sex} selected={index === 0}>{sex}</option>
                    ))}
                </select>
            </label>
            <label for="age">
                Âge
                <select id="age">
                    {ages.map((age, index) => (
                        <option value={age.trim()} selected={index === 0}>{age.trim()}</option>
                    ))}
                </select>
            </label>
        </div>
        <p id="population-summary" class="map-summary" aria-live="polite"></p>
        <div
            id="population-map"
            class="map-container population-map"
            role="application"
            aria-label="Carte choroplèthe de la population des départements"
        ></div>
        <p class="mt-8"><a href="/">← Retour au sommaire</a></p>
    </main>
</Layout>

<script>
    import L from "leaflet";
    import population from "../assets/populationMain.json";
    import departments from "../assets/departements.geojson.json";

    const mapContainer =
        document.querySelector<HTMLDivElement>("#population-map");
    const periodSelect =
        document.querySelector<HTMLSelectElement>("#periode");
    const sexSelect = document.querySelector<HTMLSelectElement>("#sexe");
    const ageSelect = document.querySelector<HTMLSelectElement>("#age");
    const summary = document.querySelector<HTMLParagraphElement>(
        "#population-summary",
    );

    if (mapContainer && periodSelect && sexSelect && ageSelect) {
        const map = L.map(mapContainer).setView([46.6, 2.3], 6);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution:
                '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            maxZoom: 19,
        }).addTo(map);

        let layer: L.GeoJSON | undefined;

        function renderMap() {
            const selectedPeriod = Number(periodSelect.value);
            const selectedSex = sexSelect.value;
            const selectedAge = ageSelect.value;
            const values = new Map(
                population
                    .filter(
                        (row) =>
                            row["Période"] === selectedPeriod &&
                            row["Sexe"] === selectedSex &&
                            row["Âge"].trim() === selectedAge,
                    )
                    .map((row) => [row["Géographie"], row["Valeur"]]),
            );
            const maximum = Math.max(...values.values(), 1);

            layer?.remove();
            layer = L.geoJSON(departments, {
                style: (feature) => {
                    const value = values.get(feature?.properties?.nom) ?? 0;
                    return {
                        fillColor: colorFor(value, maximum),
                        weight: 1,
                        color: "#64748b",
                        fillOpacity: 0.78,
                    };
                },
                onEachFeature: (feature, featureLayer) => {
                    const name = feature.properties?.nom ?? "Département";
                    const value = values.get(name);
                    featureLayer.bindPopup(
                        `<strong>${escapeHtml(name)}</strong><br>${value?.toLocaleString("fr-FR") ?? "Donnée indisponible"} habitant(s)`,
                    );
                },
            }).addTo(map);
            summary?.replaceChildren(
                document.createTextNode(
                    `${values.size} départements affichés — ${selectedPeriod}, ${selectedSex}, ${selectedAge}`,
                ),
            );
        }

        [periodSelect, sexSelect, ageSelect].forEach((select) =>
            select.addEventListener("change", renderMap),
        );
        renderMap();
    }

    function colorFor(value: number, maximum: number) {
        const intensity = Math.max(0, Math.min(value / maximum, 1));
        return `rgb(${Math.round(224 - intensity * 140)}, ${Math.round(
            242 - intensity * 100,
        )}, ${Math.round(236 - intensity * 40)})`;
    }

    function escapeHtml(value: string) {
        return value.replace(
            /[&<>"']/g,
            (character) =>
                ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#039;",
                })[character] ?? character,
        );
    }
</script>
