---
import "leaflet/dist/leaflet.css";
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Établissements universitaires — Carte Leaflet"
    description="Carte interactive des établissements universitaires en France."
>
    <main class="ml-40 mt-10">
        <h1>Établissements universitaires</h1>
        <p>
            Carte interactive des établissements recensés, centrée sur la
            France métropolitaine.
        </p>
        <div
            id="establishments-map"
            class="map-container"
            role="application"
            aria-label="Carte des établissements universitaires"
        ></div>
        <p class="mt-8"><a href="/">← Retour au sommaire</a></p>
    </main>
</Layout>

<script>
    import L from "leaflet";
    import establishments from "../assets/listeEtablissements.json";

    const container = document.querySelector<HTMLDivElement>(
        "#establishments-map",
    );

    if (container) {
        const map = L.map(container).setView([46.6033, 1.883], 6);

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution:
                '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            maxZoom: 19,
        }).addTo(map);

        establishments.forEach((establishment) => {
            if (
                typeof establishment.lat !== "number" ||
                typeof establishment.lon !== "number"
            ) {
                return;
            }

            L.circleMarker([establishment.lat, establishment.lon], {
                radius: 5,
                color: "#126e63",
                fillColor: "#66b3a6",
                fillOpacity: 0.8,
                weight: 1,
            })
                .bindPopup(
                    `<strong>${escapeHtml(establishment.name)}</strong>`,
                )
                .addTo(map);
        });
    }

    function escapeHtml(value: string) {
        return value.replace(
            /[&<>"']/g,
            (character) =>
                ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#039;",
                })[character] ?? character,
        );
    }
</script>
